{
  "name": "@mestuka/rjsf-visual-builder",
  "version": "0.1.11",
  "description": "A drag-and-drop visual builder component for react-jsonschema-form (RJSF).",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasondhoman/rjsf-visual-builder"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "tsc -b && vite build",
    "prepublishOnly": "pnpm run build:lib",
    "test": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@rjsf/core": "^6.0.0",
    "@rjsf/utils": "^6.0.0",
    "@rjsf/validator-ajv8": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@rjsf/core": "^6.10.1",
    "@rjsf/utils": "^6.10.1",
    "@rjsf/validator-ajv8": "^6.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
